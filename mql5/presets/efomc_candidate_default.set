InpMinStopPts=50.0
InpMaxSpreadPts=1500.0
InpAtrPeriodD1=14
InpInitialBalance=0.0
InpMaxLossLimitPct=10.0
InpAccountFloorDDPct=8.0
InpDailyStopPct=4.0
InpMinLot=0.01
InpMaxLot=50.0
InpMagicBase=950740
InpSlippagePoints=30
InpVerboseLog=true
