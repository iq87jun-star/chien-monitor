; ==============================================================
; Chien_ForwardRecorder_RecentFit v1.10 — チャート1(docs/218 §3 / §8 → docs/223 §5.6 / docs/224 §6 で改訂)
; 担当: Mon 7(円クロス)+ v4 10 + Dow 5(候補)+ Sess 8(候補・docs/233 S1〜S5 + docs/234 S6〜S8)= 30 レグ(Hold 7 は Swap-Free 無しで除外・指数/ETH Mon 7 は入金額の制約で除外・docs/224 §3・§6b)
; 口座: FNmarkets RAW #511030(ヘッジング・実弾小額)。USDJPY H1 チャートに1枚。
; 銘柄名は FNmarkets 実名(docs/224 §1): US500→SPX500 / NAS100→NDX100 / FR40→FRA40
;
; 設計(docs/218 §2 / docs/224 §6):
;  - InpInitialBalance=60000 を固定 → 各レグのロットが口座残高から独立
;  - 重み0.10・InpMult=1.0 → 1レグの名目 = $6,000(Mon は4ショットで1,500×4 → FX 0.01 lot)
;    NDX100/GER40 は 0.1 lot 最小 = $2,900 のため重み 0.20(ショット $3,000)
;    ピーク総名目 ≈ $102k(1:500 で必要証拠金 ≈ $204。制約は損益のみ)
;  - ガードは全無効化(期限2030 / 日次0 / balance0 / ロックoff / フロアは実質到達不能)
;    → プロップ規則は記録後に解析的に当てる
;  - スプレッドキャップは実質無制限(999)。建ったときのスプレッドを CSV に記録するので、
;    任意のキャップを後処理で当てられる(docs/218 §8.3)
;  - Magic 基底 950000(実口座の 943400/940700 と衝突しない)
; ==============================================================
InpAcknowledgeBet=true
InpMonLegs=EURJPY:0.10,GBPJPY:0.10,USDJPY:0.10,AUDJPY:0.10,NZDJPY:0.10,CADJPY:0.10,CHFJPY:0.10
; docs/224 §6b: 指数・ETH の Mon 7 レグは外した(入金 USD 2k 運用。FN スワップで記録の代表性も低い)。戻す場合は
; ,NDX100:0.20,SPX500:0.10,GER40:0.20,JP225:0.10,UK100:0.10,FRA40:0.10,ETHUSD:0.10 を末尾に追加(入金 USD 5k が前提)
InpV4Legs=EURUSD:0.10,GBPUSD:0.10,USDJPY:0.10,AUDUSD:0.10,USDCHF:0.10,USDCAD:0.10,NZDUSD:0.10,EURJPY:0.10,GBPJPY:0.10,BTCUSD:0.10
InpHoldLegs=
; v1.20 / docs/229-230 の候補 5 本(紙上判定と並行して執行差を記録。実運用ではない)
; Thu XAUUSD は 0.01 lot = $4,327 のため重み 0.30(ショット $4,500)。他は 0.10(ショット $1,500 = 0.01 lot)
InpDowLegs=
; v1.30 / docs/233 の時間帯セル(夜間の安全通貨ドリフト)。月〜木・1ショット・重み 0.10 = 名目 $6,000(≈0.06 lot)
; 16-20 / 00-04 UTC はロール(21 UTC)を跨がない。20-00 は跨ぐので SHORT スワップ ≈ 0 の NZDUSD / AUDUSD のみ
InpSessLegs=
InpMult=1.0
InpExpiry=2030.12.31 23:59
InpInitialBalance=60000.0
InpBaselineReset=false
InpMaxLossLimitPct=99.0
InpAccountFloorDDPct=99.0
InpDailyStopPct=0.0
InpBalGuardPct=0.0
InpProfitLockEnable=false
InpNotifyEnable=false
InpNotifyEntries=false
InpMonHoursUTC=4,6,8,10
InpMonHoldHours=24
InpAtrPeriodH1=24
InpCatastropheATR=2.5
InpMinStopPips=10.0
InpMaxSpreadPips=999.0
InpMonSpreadCaps=
InpV4_RSI=14
InpV4_RSIlo=35.0
InpV4_RSIhi=65.0
InpV4_BBwin=20
InpV4_BBz=1.5
InpV4_streak=3
InpV4_dayMovePct=0.5
InpV4_ATR=14
InpV4_SLatr=1.5
InpV4_RR=1.2
InpV4_MaxHoldDays=8
InpV4AllowShort=true
InpHoldEnable=false
InpHoldCatSLPct=15.0
InpHoldMaxSpreadPts=999999.0
InpHolidayFilterEnable=true
InpMinLot=0.01
InpMaxLot=50.0
InpMagicBase=950000
InpSlippagePoints=30
InpVerboseLog=true
InpRecordCsv=true
InpRecordTag=rec1
