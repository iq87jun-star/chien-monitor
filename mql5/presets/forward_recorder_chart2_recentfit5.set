; ==============================================================
; Chien_RecentFit5_EA — チャート2(docs/218 §8.1)
; 担当: Mon GBPUSD 00UTC×12h / Mon GBPJPY 08UTC×12h / MonThuS USDCHF 木16UTC×6h
;       / RSI2a GBPUSD 30-70-5日 / RSI2b GBPJPY 20-80-3日  = 5 レグ
; ※チャート1の Mon(4/6/8/10 UTC×24h)とは時刻も保有時間も違う別セル(docs/218 §8.2)
; 口座: チャート1と同じデモ口座。GBPUSD H1 チャートに1枚。
; ガードは全無効化。基準残高は固定。Magic は実口座と衝突しない値へ。
; ==============================================================
InpMultOverride=1.0
InpS1_GbpUsdMon=true
InpS2_GbpJpyMon=true
InpS3_UsdChfThu=true
InpS4_GbpUsdRsi=true
InpS5_GbpJpyRsi=true
InpSymGBPUSD=GBPUSD
InpSymGBPJPY=GBPJPY
InpSymUSDCHF=USDCHF
InpServerToUtcHours=-999
InpSlAtrMult=3.0
InpMinHoldSeconds=150
InpInitialBalance=60000.0
InpSizeFromInitial=true
InpRiskPerTradePct=0.2
; ↑ docs/224 §6: RF5 EA v1.03 はロットを InpInitialBalance×0.2%÷(3×ATR) で出す → GBPUSD/GBPJPY ≈ 0.04 lot ≈ 名目 $6,000。口座残高に依存しない
InpBaselineReset=false
InpProfitLockEnable=false
InpNotifyEnable=false
InpVerboseLog=true
