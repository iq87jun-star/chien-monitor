; 【直近フィット・トラック既定】Chien_RecentFit5_EA v1.0 に適用(docs/174-175)。
; 構成: 直近12ヶ月フィットの5スリーブ(GBPUSD月曜L/GBPJPY月曜L/USDCHF木曜S/GBPUSD RSI2/GBPJPY RSI2)。
; MC(20000パス・選定期間リサンプル=楽観上限): 1.25%リスクで P1+P2通過99.9%/中央145日。
; ストレス(エッジ半減): 通過80%・規則失格0% / (エッジ消滅): 失格0%・guard_stop6%・大半は時間切れ。
; ⚠ 本トラックは意図的レジームベット(docs/174)。正攻法口座と混ぜない。月次でフォワード採点し
;   2ヶ月連続で月次合計R<0なら停止・再スイープ(docs/175 §5)。
; P1=LockArm8.0/LockClose8.5。P2に進んだら 5.0/5.5 に変更すること。
InpRiskPerTradePct=1.25
InpMultOverride=1.0
InpMaxSpreadBps=10.0
InpBalGuardPct=4.0
InpBalGuardMaxMonth=2
InpAccountFloorDDPct=8.0
InpInitialBalance=0.0
InpBaselineReset=false
InpProfitLockEnable=true
InpLockArmPct=8.0
InpLockClosePct=8.5
InpS1_GbpUsdMon=true
InpS2_GbpJpyMon=true
InpS3_UsdChfThu=true
InpS4_GbpUsdRsi=true
InpS5_GbpJpyRsi=true
InpSymGBPUSD=GBPUSD
InpSymGBPJPY=GBPJPY
InpSymUSDCHF=USDCHF
InpServerToUtcHours=-999
InpMagicBase=941200
