InpBaselineReset=false
InpMaxLossLimitPct=10.0
InpAccountFloorDDPct=9.0
InpNotifyEnable=true
InpNotifyEntries=true
InpNotifyRefPct=3.5
InpNotifyDayWarnPct=3.0
InpReenterManualClose=true
InpMTrailEnable=false
InpWeeklyRiskPct=1.95
InpV4RiskPerTradePct=0.58
