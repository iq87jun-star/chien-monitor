  "x-products": {
    "salary": {
      "title": "Japan Job Listing Salary Parser",
      "description": "Turn the salary text of Japanese job listings (月給25万円～＋賞与年2回（4.5ヶ月分）, 固定残業代40時間分を含む ...) into estimated annual income, hourly equivalent and fixed overtime pay. No data is stored."
    },
    "realty": {
      "title": "Japan Real Estate Listing Calculator",
      "description": "Send rent / price / area / fees as written on Japanese property pages (12.5万円, 1ヶ月/なし, 25.3m²) and get price per m² and per tsubo, effective monthly cost, move-in cost estimate, loan payment and yield. No data is stored."
    },
    "takehome": {
      "title": "Japan Take-Home Pay Calculator",
      "description": "Calculate Japanese take-home pay from monthly salary and bonus: health insurance (prefecture rates), nursing care, child support levy, pension, employment insurance, income tax and resident tax, using FY2026 official rates and the 2026 tax reform (basic deduction up to ¥1.04M, minimum employment income deduction ¥740k). Company employees in Kyokai Kenpo, single with no dependents."
    },
    "calendar": {
      "title": "Japan Holidays, Business Days & Wareki API",
      "description": "Japanese national holidays (official Cabinet Office data from 1955), business day calculation (add / count, with year-end closure and custom closed days) and conversion between Western dates and Japanese era dates (令和6年4月1日, R6.4.1, 平成元年 ...)."
    }
  }
