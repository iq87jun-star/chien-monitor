# RiskGuard licensing — environment configuration
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets.

# --- verify server (server.js) ---
PORT=8080
LICENSE_DB_PATH=./licenses.json
LICENSE_MAX_BINDINGS=2          # accounts one buy-once key may bind (buyer's terminals)

# --- webhook / issuance (webhook.js) ---
WEBHOOK_PORT=8090
PRODUCT_ID=risk-guard
LICENSE_OUTBOX_PATH=./issued-keys.log

# Gumroad Ping: set this token and append ?token=THE_SAME_VALUE to the Ping URL
GUMROAD_PING_TOKEN=

# Stripe webhook signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
